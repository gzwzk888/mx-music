# 签名配置示例：复制为 keystore.properties 后填入自己的值
# 该文件（以及 .keystore / .jks）已被 .gitignore 排除，切勿提交
#
# 生成自己的签名：
#   keytool -genkeypair -v -storetype PKCS12 -keystore my-release.keystore \
#     -alias mykey -keyalg RSA -keysize 2048 -validity 10000
#
# 不创建本文件也能构建：release 会自动退回 debug 签名（仅适合自己安装测试）

storeFile=../my-release.keystore
storePassword=your_store_password
keyAlias=mykey
keyPassword=your_key_password
